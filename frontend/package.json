{
  "name": "charie-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "shared",
    "chat",
    "learner"
  ],
  "scripts": {
    "dev:chat": "npm run dev -w @charie/chat",
    "dev:chat:mock": "npm run dev:mock -w @charie/chat",
    "dev:learner": "npm run dev -w @charie/learner",
    "dev:learner:mock": "npm run dev:mock -w @charie/learner",
    "build": "npm run build -w @charie/chat && npm run build -w @charie/learner && node scripts/check-prod-build.mjs",
    "build:mock": "npm run build:mock -w @charie/chat && npm run build:mock -w @charie/learner",
    "e2e:mock": "npm run build:mock && playwright test",
    "e2e:real": "npm run build && uv run --project ../backend python ../scripts/e2e_real.py run",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p e2e",
    "test": "vitest run",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "jsdom": "^25.0.0",
    "prettier": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
