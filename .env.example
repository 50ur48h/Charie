# Charie settings. Copy this file to .env and put real values there.
# .env is never saved to git. Every value below is fake.

# Our Postgres database.
DATABASE_URL=postgresql+psycopg://charie:charie@localhost:5433/charie
# The practice database, with the read-only login (tests and tools only).
PRACTICE_DB_URL=postgresql://charie_readonly:fake-password@localhost:5432/charie_demo
# The first login password (until it is changed in Settings).
CHARIE_PASSWORD=change-me
# Signs the login cookie. Use a long random string.
CHARIE_SECRET_KEY=fake-random-string-change-me
# Encrypts saved database passwords (a Fernet key).
CHARIE_ENCRYPTION_KEY=fake-fernet-key-change-me
# The web address of the chat app, used by "Open Learner" / "Open Charie" links.
CHARIE_CHAT_URL=http://localhost:5173
# The web address of the learner app.
CHARIE_LEARNER_URL=http://localhost:5174
# The Meta Muse API key.
META_API_KEY=fake-meta-api-key
# The Meta API address (OpenAI-style).
META_API_BASE_URL=https://api.meta.ai/v1
# Azure AI Document Intelligence address (from Phase 8).
AZURE_DI_ENDPOINT=https://example.cognitiveservices.azure.com/
# Azure AI Document Intelligence key (from Phase 8).
AZURE_DI_KEY=fake-azure-di-key
# Azure OpenAI address for embeddings (from Phase 8).
AZURE_OPENAI_ENDPOINT=https://example.openai.azure.com/
# Azure OpenAI key (from Phase 8).
AZURE_OPENAI_KEY=fake-azure-openai-key
# The embedding deployment name (from Phase 8).
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
# The Azure OpenAI API version (from Phase 8).
AZURE_OPENAI_API_VERSION=2024-10-21
# Saved AI replies: off, record or replay.
AI_REPLAY=off
# The folder for saved AI replies.
AI_REPLAY_DIR=backend/tests/replays/
# Where the app runs: local or azure.
APP_ENV=local
