# Charie — local configuration template.

# --- Phase 0 — API service ---
# local | ci | dev | prod
ENV=local
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# browser origins allowed to call the API
CORS_ORIGINS=http://localhost:3000
API_PORT=8000
# GIT_SHA is baked into the image at build time; leave unset locally.

# --- Phase 2 — authentication ---
# dev | entra
AUTH_MODE=dev
# every accepted token must claim this
OIDC_AUDIENCE=charie-api
# where the dev issuer publishes its keys
DEV_ISSUER_URL=http://localhost:8000/dev

# For AUTH_MODE=entra. OIDC_AUTHORITY is where the discovery document lives.
# OIDC_AUTHORITY=https://<domain-prefix>.ciamlogin.com/<tenant-id>/v2.0
# Comma-separated: an Entra v2 access token carries the resource's client-ID GUID as `aud`.
# OIDC_AUDIENCE=api://<charie-api-client-id>,<charie-api-client-id>
# OIDC_ISSUER=

# Web sign-in (WP2.3). NEXT_PUBLIC_* is inlined into the browser bundle.
NEXT_PUBLIC_ENV=local
# NEXT_PUBLIC_AUTH_MODE=entra
# NEXT_PUBLIC_ENTRA_AUTHORITY=https://<domain-prefix>.ciamlogin.com/<tenant-id>
# NEXT_PUBLIC_ENTRA_CLIENT_ID=<spa-client-id>
# NEXT_PUBLIC_API_SCOPE=api://<charie-api-client-id>/access_as_user

# --- Phase 0 — web app ---
# where the *browser* reaches the API
NEXT_PUBLIC_API_URL=http://localhost:8000
WEB_PORT=3000

# --- Phase 0 — platform database (compose service `platform-pg`) ---
PLATFORM_DB_NAME=charie
PLATFORM_DB_USER=charie
PLATFORM_DB_PASSWORD=local_dev_only_change_me
PLATFORM_DB_PORT=5432

# Two roles, on purpose (architecture Part 6.3).
DATABASE_URL=postgresql+asyncpg://charie:local_dev_only_change_me@localhost:5432/charie
APP_DB_PASSWORD=local_dev_only_change_me_app
APP_DATABASE_URL=postgresql+asyncpg://charie_app:local_dev_only_change_me_app@localhost:5432/charie
# Both passwords are inside the URLs above locally, so these two are for the deployment (WP12.2).
# DB_PASSWORD=
# APP_DB_PASSWORD above serves both roles: locally it is compose's.

# --- Phase 0 — pizza demo database (compose service `seed-pizza-pg`) ---
SEED_PIZZA_DB=pizza
SEED_PIZZA_USER=pizza
SEED_PIZZA_PASSWORD=local_dev_only_change_me
SEED_PIZZA_HOST=localhost
SEED_PIZZA_PORT=6543

# The login a data source should actually be registered with: `make seed` creates it with CONNECT.
SEED_PIZZA_READONLY_USER=pizza_readonly
SEED_PIZZA_READONLY_PASSWORD=local_dev_only_change_me_ro

# --- Phase 3 — where data-source credentials are kept ---
# local | keyvault
SECRETS_BACKEND=local
LOCAL_SECRETS_KEY=
# Optional. Defaults to ops/.secrets/secrets.json beside this file.
# LOCAL_SECRETS_PATH=
# Key Vault's address, required when SECRETS_BACKEND=keyvault and meaningless otherwise (WP12.2).
# KEY_VAULT_URL=https://kv-charie-dev-xxxxxx.vault.azure.net/

# --- Phase 3 — encryption to customer databases (B-013) ---
# require | verify-ca | verify-full
TLS_MODE=require
# disable | prefer | require | verify-ca | verify-full — local addresses only
TLS_MODE_LOCAL=prefer
# comma-separated extra hostnames that count as local
TLS_LOCAL_HOSTS=
# PEM bundle for the verify-* modes. Unset means the system trust store.
# TLS_CA_FILE=

# --- Phase 3 — SQL Server demo database (compose profile `mssql`) ---
MSSQL_SA_PASSWORD=Local_dev_only_1
MSSQL_PORT=1433
MSSQL_DB=pizza

# The login to register the SQL Server data source with.
MSSQL_PIZZA_READONLY_USER=pizza_readonly
MSSQL_PIZZA_READONLY_PASSWORD=Local_dev_only_ro_1

# --- Phase 5 — what one query may cost, and how long its answer is kept ---
# DAL_MAX_ROWS=1000
# DAL_TIMEOUT_SECONDS=30
# ARTIFACTS_PATH=ops/artifacts
# Which store, from WP12.2: local files, or Azure Blob by managed identity.
# ARTIFACTS_BACKEND=local
# Required when ARTIFACTS_BACKEND=blob.
# ARTIFACTS_ACCOUNT_URL=https://stchariedevxxxxxx.blob.core.windows.net/
# The container results go to. `documents` is a separate one and is not this.
# ARTIFACTS_CONTAINER=artifacts
# Retention is a promise to the customer, so it is written onto each row.
# ARTIFACT_RETENTION_DAYS=30

# --- Phase 6 — which model does which job (architecture 4.9, 8.3) ---
LLM_PROVIDERS=meta
# JSON: provider -> tier -> model id
LLM_MODELS={"meta":{"small":"muse-spark-1.3","mid":"muse-spark-1.3","strong":"muse-spark-1.3"}}
# One-command demo only: everyone who signs in joins this organization. Leave unset.
# DEMO_ORG=
# Meta models a person can pick per question in the app; the default comes first.
LLM_SELECTABLE_MODELS=muse-spark-1.3,muse-wonder-1.0
# JSON: role -> tier. Keep planning/SQL on strong; compose can use small.
LLM_ROLE_MAP={"compose":"small"}
# JSON: model id -> USD per MILLION tokens. Required for capped calls.
LLM_PRICES={"muse-spark-1.3":{"input":1.25,"output":4.25},"muse-wonder-1.0":{"input":4.00,"output":20.00}}

# --- Phase 6 — spending ceilings ---
# Muse Wonder costs about four times Muse Spark per token, so the cap leaves room for it.
LLM_RUN_COST_LIMIT_USD=5.00
# LLM_REFUSE_UNPRICED_WHEN_CAPPED=true

# Provider keys are real secrets: never commit one.
META_API_KEY=
# Reasoning tokens count toward output limits.
META_REASONING_EFFORT=minimal
