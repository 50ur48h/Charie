#!/bin/sh
# Strip AI attribution from commit messages (AGENTS.md, "Git workflow").
# Enable once per clone: git config core.hooksPath .githooks
msg="$1"
tmp="$msg.tmp.$$"
grep -v -i -E \
  -e '^co-authored-by:.*(claude|anthropic|copilot|muse|meta\.ai|openai|codex|gemini|cursor)' \
  -e '^claude-session:' \
  -e 'generated with \[?(claude|copilot|muse)' \
  "$msg" > "$tmp"
mv "$tmp" "$msg"
